{
  "types": {
    "authenticator": [
      "PasswordAuthenticators"
    ],
    "enrollment_flow_step": [
      "PasswordCollectors"
    ]
  },
  "schema": {
    "tables": {
      "password_authenticators": {
        "columns": {
          "id": {},
          "authenticator_id": {},
          "source_mode": { "type": "string", "size": 2 },
          "min_length": { "type": "integer" },
          "max_length": { "type": "integer" },
          "format_crypt_php": { "type": "boolean" },
          "format_plaintext": { "type": "boolean" },
          "format_sha1_ldap": { "type": "boolean" },
          "prevent_reuse": { "type": "boolean" },
          "use_hard_delete": { "type": "boolean" }
        },
        "indexes": {
          "password_authenticators_i1": { "columns": [ "authenticator_id" ]}
        }
      },
      "password_collectors": {
        "columns": {
          "id": {},
          "enrollment_flow_step_id": {},
          "authenticator_id": { "notnull": false, "comment": "No value is set when the skeletal row is created" },
          "required": {}
        },
        "indexes": {
          "password_collectors_i1": { "columns": [ "enrollment_flow_step_id" ] },
          "password_collectors_i2": { "needed": false, "columns": [ "authenticator_id"] }
        }
      },
      "passwords": {
        "columns": {
          "id": {},
          "password_authenticator_id": { "type": "integer", "foreignkey": { "table": "password_authenticators", "column": "id" }, "notnull": true },
          "person_id": {},
          "password": { "type": "string", "size": 256 },
          "type": { "type": "string", "size": 2 }
        },
        "indexes": {
          "passwords_i1": { "columns": [ "password_authenticator_id" ]},
          "passwords_i2": { "columns": [ "person_id" ]}
        }
      },
      "petition_passwords": {
        "columns": {
          "id": {},
          "petition_id": {},
          "password_collector_id": { "type": "integer", "foreignkey": { "table": "password_collectors", "column": "id" } },
          "password": { "type": "string", "size": 256 },
          "type": { "type": "string", "size": 2 }
        },
        "indexes": {
          "petition_passwords_i1": { "columns": [ "petition_id" ]},
          "petition_passwords_i2": { "columns": [ "password_collector_id" ]}
        },
        "changelog": false
      }
    }
  }
}